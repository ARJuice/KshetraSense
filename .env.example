# ==============================================================================
# KshetraSense Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` (or `.env.local`) and configure values for your setup.
# Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Settings (Vite)
# ------------------------------------------------------------------------------
# URL of the local or remote FastAPI backend service
VITE_ZONING_API_URL=http://127.0.0.1:8000

# Optional separate CropSight API endpoint (defaults to ${VITE_ZONING_API_URL}/cropsight)
VITE_CROPSIGHT_API_URL=http://127.0.0.1:8000/cropsight

# ------------------------------------------------------------------------------
# Backend & API Gateway Settings (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
# Allowed CORS origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# SoilGrids WCS Context Service
# ------------------------------------------------------------------------------
# Public ISRIC Web Coverage Service endpoint for regional soil property context
SOILGRIDS_WCS_URL=https://maps.isric.org/mapserv

# ------------------------------------------------------------------------------
# Google Earth Engine / CropSight Remote Sensing Settings
# ------------------------------------------------------------------------------
# Google Cloud Project ID authorized for Google Earth Engine access.
# Required for live Sentinel-2 satellite imagery and CHIRPS rainfall queries.
# Authenticate on your machine via: `earthengine authenticate`
EARTHENGINE_PROJECT=kshetrasense-earth-engine
