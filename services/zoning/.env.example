# ==============================================================================
# KshetraSense Zoning & Monitoring Service Environment Template
# ==============================================================================
# Copy this file to `.env` in this directory (or use repository root `.env`).
# ==============================================================================

# Allowed CORS origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Public ISRIC Web Coverage Service endpoint for regional soil property context
SOILGRIDS_WCS_URL=https://maps.isric.org/mapserv

# Google Cloud Project ID authorized for Google Earth Engine access (CropSight)
EARTHENGINE_PROJECT=kshetrasense-earth-engine
